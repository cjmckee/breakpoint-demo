{
  "name": "ai-slop-tennis",
  "version": "1.0.0",
  "description": "Simplified tennis RPG with transparent stat-based simulation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx src/test/migrationCheck.ts",
    "test:rally": "tsx test/testRallyAnalysis.ts",
    "analyze": "tsx src/test/analysis/balanceAnalysis.ts",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "tennis",
    "rpg",
    "simulation",
    "game",
    "sports"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "rimraf": "^5.0.0",
    "tailwindcss": "3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^4.5.14",
    "vite-plugin-pwa": "^0.17.5",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mixpanel-browser": "^2.78.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  }
}
